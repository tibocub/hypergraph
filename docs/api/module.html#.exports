            <td class="type">
            
                
<span class="param-type">string</span>


            
            </td>

            

            

            <td class="description last">The recipient's hex public key (their signing/author identity)</td>
        </tr>

    

        <tr>
            
                <td class="name"><code>recipientEncryptionPublicKey</code></td>
            

            <td class="type">
            
                
<span class="param-type">Buffer</span>


            
            </td>

            

            

            <td class="description last">The recipient's stable encryptionKeyPair.publicKey to seal to</td>
        </tr>

    
    </tbody>
</table>






