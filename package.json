{
  "name": "hypergraph",
  "version": "0.0.1",
  "description": "P2P graph store built on Hypercore/Autobase with a focus on ease of use.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./next": "./lib/index.js",
    "./v2": "./src/v2/index.js",
    "./tools/inspector": "./tools/inspector/index.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "hypergraph-inspect": "bin/hypergraph-inspector.js"
  },
  "scripts": {
    "test": "node scripts/test-runner.js",
    "bench:quick": "node bench/chat.js 10000 --writers 10 --live 30 && node --expose-gc bench/channels.js 50 && node --expose-gc bench/members.js 1000",
    "bench:chat": "node bench/chat.js 100000 --writers 10 --live 30",
    "test:all": "npm test && npm run test:next && npm run test:next:bare",
    "test:serial": "npm run test:core && npm run test:networking && npm run test:replication && npm run test:forum && npm run test:integration",
    "test:entities": "npx brittle-node test/brittle/core/entities.js",
    "test:events": "npx brittle-node test/brittle/core/events.js",
    "test:identity-manager": "npx brittle-node test/brittle/core/identity-manager.js test/brittle/core/identity-graph.js",
    "test:contexts": "npx brittle-node test/brittle/core/contexts.js",
    "test:view": "npx brittle-node test/brittle/core/view.js",
    "test:user-core": "npx brittle-node test/brittle/core/user-core.js",
    "test:error-cases": "npx brittle-node test/brittle/core/error-cases.js",
    "test:relations": "npx brittle-node test/brittle/core/relations.js",
    "test:tags": "npx brittle-node test/brittle/core/tags.js",
    "test:queries": "npx brittle-node test/brittle/core/query.js",
    "test:roles": "npx brittle-node test/brittle/core/roles.js",
    "test:moderation": "npx brittle-node test/brittle/core/moderation.js",
    "test:core": "npx brittle-node test/brittle/core/*.js",
    "test:hypergraph-network": "npx brittle-node test/brittle/networking/hypergraph-network.js",
    "test:connect-to-swarm": "npx brittle-node test/brittle/networking/connect-to-swarm.js",
    "test:peer-connection": "npx brittle-node test/brittle/networking/peer-connection.js",
    "test:bootstrap-export": "npx brittle-node test/brittle/networking/bootstrap-export.js",
    "test:writer-authorization": "npx brittle-node test/brittle/networking/writer-authorization.js",
    "test:networking": "npx brittle-node test/brittle/networking/*.js",
    "test:late-joiner": "npx brittle-node test/brittle/replication/late-joiner.js",
    "test:concurrent-writes": "npx brittle-node test/brittle/replication/concurrent-writes.js",
    "test:peer-reconnection": "npx brittle-node test/brittle/replication/peer-reconnection.js",
    "test:multi-peer": "npx brittle-node test/brittle/replication/multi-peer.js",
    "test:out-of-order": "npx brittle-node test/brittle/replication/out-of-order.js",
    "test:partial-replication": "npx brittle-node test/brittle/replication/partial-replication.js",
    "test:hypergraph-network-integration": "npx brittle-node test/brittle/replication/hypergraph-network-integration.js",
    "test:replication": "npx brittle-node test/brittle/replication/*.js",
    "test:forum": "npx brittle-node test/brittle/forum/index.js",
    "test:integration": "npx brittle-node test/brittle/integration/*.js",
    "populate:inspector": "node scripts/populate-inspector-fixture.js",
    "validate:roles": "node scripts/validate-roles.js",
    "forum:web:owner": "node examples/forum-web/peer.js --name=owner --role=owner --topic=hyper-bbs-forum-demo",
    "forum:web:peer": "node examples/forum-web/peer.js --name=peer --role=peer --topic=hyper-bbs-forum-demo",
    "docs": "jsdoc -c jsdoc.json",
    "test:next": "node scripts/test-runner.js next",
    "test:next:bare": "node scripts/test-runner.js --bare next"
  },
  "dependencies": {
    "autobase": "^7.28.2",
    "b4a": "^1.9.0",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "blind-pairing": "^2.3.1",
    "codecs": "^3.1.0",
    "compact-encoding": "^3.5.2",
    "corestore": "^7.13.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.37.2",
    "hypercore-crypto": "^3.7.0",
    "hyperdb": "^6.10.0",
    "hyperschema": "^1.26.2",
    "hyperswarm": "^4.17.2",
    "index-encoder": "^3.5.0",
    "keet-identity-key": "^3.2.0",
    "protomux": "^3.12.1",
    "protomux-wakeup": "^2.9.0",
    "ready-resource": "^1.2.0",
    "safety-catch": "^1.0.3",
    "sodium-universal": "^5.0.1",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bare": "^1.34.1",
    "bare-subprocess": "^6.2.2",
    "blind-peer": "^3.16.0",
    "blind-peering": "^2.10.1",
    "brittle": "^4.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "hyperdht": "6.32.0",
    "random-access-memory": "^6.2.1"
  },
  "license": "MIT",
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    }
  },
  "overrides": {
    "hyperdht": "$hyperdht"
  }
}
