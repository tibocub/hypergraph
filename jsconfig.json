{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": ["lib/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "lib/index/spec/**", "lib/symbols.js", "src", "examples", "test"]
}
